# Copy to .env (never commit .env). All backend settings; see backend/app/config.py.
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
# Use Vertex AI for Gemini (recommended on Cloud Run). Or set GOOGLE_API_KEY instead for AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_API_KEY=
GCS_BUCKET=your-photos-bucket
# firestore | memory  (memory = in-process fake, no GCP needed)
DB_BACKEND=firestore
# FIRESTORE_EMULATOR_HOST=localhost:8080
# Vertex AI GA live model. On AI Studio (GOOGLE_API_KEY) use e.g. gemini-3.1-flash-live-preview.
LIVE_MODEL=gemini-live-2.5-flash-native-audio
TEXT_MODEL=gemini-2.5-flash
VISION_MODEL=gemini-2.5-flash
# Agent voice: the Live API has no speed setting, so pace is part of the agent's instruction.
# VOICE_PACE: slower (default, a little slower with pauses around numbers) | normal
VOICE_PACE=slower
# Prebuilt voice name (e.g. Kore, Charon, Aoede, Puck); empty = model default. Some voices sound calmer/slower.
LIVE_VOICE=
# Push-to-talk turns reach Gemini only with at least this much speech (taps, silence, noise are dropped)
PTT_MIN_SPEECH_MS=200
PTT_SPEECH_RMS=300
# Vehicle manual lookup (C08). Production reads manuals from gs://$GCS_BUCKET/manuals/ (the default when
# GCS_BUCKET is set); development from backend/manuals/pdf/ (git-ignored: manufacturer PDFs are never committed).
# MANUALS_SOURCE=gs://my-bucket/manuals/
EMBED_MODEL=gemini-embedding-001
# Must match the vector index dimension on manual_chunks (firestore.indexes.json)
EMBED_DIM=768
# Texts per embedding request (gemini-embedding-001 on Vertex AI: 1)
EMBED_BATCH=1
# The import reads each PDF page with this model (scanned pages, spec tables as "label: value unit" lines);
# a page it can't read falls back to the PDF's own text. Pages read in parallel:
TRANSCRIBE_MODEL=gemini-2.5-flash
TRANSCRIBE_WORKERS=4
MANUAL_TOP_K=3
# Cosine similarity below this = "not in the manual" (tune with real questions)
MANUAL_MIN_SCORE=0.6
# Long random string; signs customer /j/:token links
LINK_SECRET=change-me
LINK_TTL_HOURS=72
PUBLIC_BASE_URL=http://localhost:5173
DEFAULT_LOW_STOCK=1
APPROVAL_NUDGE_MINUTES=30
# Cloud Scheduler -> POST /api/tasks/sweep (OIDC token from this service account, for this audience)
SCHEDULER_SA_EMAIL=scheduler@your-gcp-project.iam.gserviceaccount.com
SCHEDULER_AUDIENCE=https://your-service-url/api/tasks/sweep
# Comma-separated browser origins allowed to call the API directly (not needed behind Firebase Hosting rewrites)
CORS_ORIGINS=
# 1 = skip Firebase ID token checks (local demo only)
AUTH_DISABLED=0
