# Copy to .env.local (never commit it). Firebase web config is public by design, but keep it per environment.
# Backend base URL; empty = same origin (Firebase Hosting rewrites /api and /ws to Cloud Run).
VITE_API_BASE=
# Voice WebSocket base. Firebase Hosting cannot proxy WebSockets: set this to the Cloud Run URL in production,
# e.g. wss://garage-copilot-xxxx-el.a.run.app. Empty = same origin (fine with `npm run dev`).
VITE_WS_BASE=
# Firebase web app config. Leave empty to run without Firebase (dev tokens + polling, backend AUTH_DISABLED=1).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Point the web SDK at local emulators (e.g. localhost:8080 for Firestore)
VITE_FIRESTORE_EMULATOR_HOST=
# The garage the landing page's "Call the garage" button reaches (AI front desk), by id and display name
VITE_FRONT_DESK_GARAGE=shree-auto
VITE_FRONT_DESK_GARAGE_NAME=Shree Auto
